<!--
  SSDF edge hardening (L1a): enable HTTPS on ClickHouse ct104.

  Drop-in for /etc/clickhouse-server/config.d/ — merged over config.xml, so the
  base config stays distro-pristine. Plain 8123 keeps listening for
  container-local admin; the LAN side of 8123/9000 is closed by nftables
  (infra/firewall/ct104-clickhouse.nft), not here.

  Element names verified against the ClickHouse server-settings docs
  (https_port + openSSL/server: certificateFile, privateKeyFile,
  disableProtocols, preferServerCiphers — Poco::Net SSL options).
  dhParamsFile is intentionally omitted: our RSA-key TLS 1.2+ cipher set does
  not need DH params and pointing at a missing file fails startup.
-->
<clickhouse>
    <https_port>8443</https_port>
    <openSSL>
        <server>
            <certificateFile>/etc/clickhouse-server/tls/ct104.crt</certificateFile>
            <privateKeyFile>/etc/clickhouse-server/tls/ct104.key</privateKeyFile>
            <!-- server does not request client certs; clients authenticate
                 with CH users over the encrypted channel -->
            <verificationMode>none</verificationMode>
            <cacheSessions>true</cacheSessions>
            <!-- TLS 1.2+ only, mirroring the nginx edge -->
            <disableProtocols>sslv2,sslv3,tlsv1,tlsv1_1</disableProtocols>
            <preferServerCiphers>true</preferServerCiphers>
        </server>
    </openSSL>
</clickhouse>
