# SSDF M3 — PAN-OS log-forwarding onboarding.
# Applied to panosvm (PAN-OS 12.1.5, PA-VM) via panos-mcp. NOTE: load_and_commit_pan_config
# was retired 2026-08-15; the server now requires the approval-gated change-set lifecycle,
# which takes XPath/XML rather than this set-format file. See onboarding/panos/README.md.
# Substitutions (as-built 2026-06-06, panosvm):
#   <vector-host-ip> = 198.51.100.150  (ssdf-vector LXC guest 700 (was ct102), UDP/515)
#   <vector-port>    = 515             (SRX already uses 514; PAN-OS gets 515)
#
# Prerequisites:
#   - The SSDF Vector collector (guest 700 (was ct102)) must already be listening on UDP:515
#     (panos_syslog source live in infra/vector/vector.toml) before applying.
#   - Apply via panos-mcp against host "panosvm" only.
#   - Review the diff before committing (diff_panos_candidate, against an existing operation).

# ---------------------------------------------------------------------------
# 1. Shared syslog server profile
# ---------------------------------------------------------------------------
set shared log-settings syslog SSDF server ssdf-vector server 198.51.100.150
set shared log-settings syslog SSDF server ssdf-vector transport UDP
set shared log-settings syslog SSDF server ssdf-vector port 515
set shared log-settings syslog SSDF server ssdf-vector format BSD

# ---------------------------------------------------------------------------
# 2. vsys1 log-forwarding profile — one match-list entry per log type
# ---------------------------------------------------------------------------
set vsys vsys1 log-settings profiles SSDF-LF match-list traffic-all log-type traffic filter "All Logs" send-syslog SSDF
set vsys vsys1 log-settings profiles SSDF-LF match-list threat-all log-type threat filter "All Logs" send-syslog SSDF
set vsys vsys1 log-settings profiles SSDF-LF match-list url-all log-type url filter "All Logs" send-syslog SSDF
set vsys vsys1 log-settings profiles SSDF-LF match-list wildfire-all log-type wildfire filter "All Logs" send-syslog SSDF
set vsys vsys1 log-settings profiles SSDF-LF match-list data-all log-type data filter "All Logs" send-syslog SSDF
set vsys vsys1 log-settings profiles SSDF-LF match-list tunnel-all log-type tunnel filter "All Logs" send-syslog SSDF
set vsys vsys1 log-settings profiles SSDF-LF match-list auth-all log-type auth filter "All Logs" send-syslog SSDF
set vsys vsys1 log-settings profiles SSDF-LF match-list decryption-all log-type decryption filter "All Logs" send-syslog SSDF

# ---------------------------------------------------------------------------
# 3. Attach log-forwarding profile to each vsys1 security rule
# ---------------------------------------------------------------------------
set vsys vsys1 rulebase security rules drifttest1 log-setting SSDF-LF
set vsys vsys1 rulebase security rules drifttest1 log-end yes
set vsys vsys1 rulebase security rules allow-trust-to-dmz log-setting SSDF-LF
set vsys vsys1 rulebase security rules allow-trust-to-dmz log-end yes
set vsys vsys1 rulebase security rules allow-corp-to-internet log-setting SSDF-LF
set vsys vsys1 rulebase security rules allow-corp-to-internet log-end yes
set vsys vsys1 rulebase security rules allow-untrust-to-trust log-setting SSDF-LF
set vsys vsys1 rulebase security rules allow-untrust-to-trust log-end yes
set vsys vsys1 rulebase security rules allow-trust-to-untrust log-setting SSDF-LF
set vsys vsys1 rulebase security rules allow-trust-to-untrust log-end yes

# ---------------------------------------------------------------------------
# 4. Device-level log-settings (non-session / system-plane logs)  [Stage B]
#    These use the shared log-settings path, not deviceconfig.
#    AS-BUILT 2026-06-07: system + config applied & committed live (real SYSTEM
#    logs across 9 subtypes + CONFIG set/commit logs confirmed in ssdf.events).
#    correlation/globalprotect/hipmatch left UNAPPLIED — those features are not
#    configured on this device, so they would generate no logs.
#
#    IMPORTANT (panos-mcp gotcha): apply Stage B via fmt=xml with an ABSOLUTE
#    xpath beginning "/config/...". A relative xpath like "shared/log-settings"
#    makes pan-os-python's xapi.set send a non-absolute xpath, which PAN-OS
#    rejects as "Unauthorized request" (misleading — it is NOT an auth/permission
#    problem; the mcp-api admin is superuser). Absolute xpath = success.
#    Equivalent XML applied:
#      xpath=/config/shared/log-settings
#      element=<system><match-list><entry name="all-system">
#                <send-syslog><member>SSDF</member></send-syslog>
#                <filter>All Logs</filter></entry></match-list></system>
#      element=<config><match-list><entry name="all-config">...</entry></match-list></config>
set shared log-settings system match-list all-system filter "All Logs" send-syslog SSDF
set shared log-settings config match-list all-config filter "All Logs" send-syslog SSDF
# set shared log-settings correlation match-list corr-all filter "All Logs" send-syslog SSDF  # not applied (no correlation features)
# set shared log-settings globalprotect match-list gp-all filter "All Logs" send-syslog SSDF  # not applied (no GP configured)
# set shared log-settings hipmatch match-list hip-all filter "All Logs" send-syslog SSDF       # not applied (no HIP configured)
