# services/entity/infra/ssdf-entity.service
[Unit]
Description=SSDF M6 entity resolver (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
RuntimeMaxSec=600
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/ssdf-entity/ENV.local
ExecStart=/opt/ssdf-entity/bin/python -m ssdf_entity.resolve_main
SuccessExitStatus=0
