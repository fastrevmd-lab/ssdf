# services/policy/infra/ssdf-policy.service
[Unit]
Description=SSDF M6b configured-policy collector + resolver (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
# Type=oneshot runs the whole collect+resolve during ACTIVATION, which
# RuntimeMaxSec does not bound — that limit applies to a service already
# active. TimeoutStartSec defaults to infinity for oneshot, so before this a
# single unanswered vendor-MCP call wedged the unit indefinitely (observed:
# 91 minutes) and the timer never re-fired, freezing the graph.
TimeoutStartSec=600
RuntimeMaxSec=900
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/ssdf-policy/ENV.local
ExecStart=/opt/ssdf-policy/bin/python -m ssdf_policy.collect_resolve
SuccessExitStatus=0
