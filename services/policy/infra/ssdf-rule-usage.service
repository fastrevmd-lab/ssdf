# services/policy/infra/ssdf-rule-usage.service
[Unit]
Description=SSDF MEC-566 rule-usage hourly rollup (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
# Same TimeoutStartSec/RuntimeMaxSec reasoning as ssdf-policy.service: a
# Type=oneshot unit's activation is unbounded by RuntimeMaxSec, so a single
# wedged ClickHouse call would otherwise hang the unit (and the timer)
# indefinitely instead of failing and re-firing on the next OnUnitActiveSec.
TimeoutStartSec=300
RuntimeMaxSec=300
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=CH_USER=ssdf_ruleusage
EnvironmentFile=/etc/ssdf-rule-usage/ENV.local
ExecStart=/opt/ssdf-policy/bin/python -m ssdf_policy.rule_usage_rollup
SuccessExitStatus=0
